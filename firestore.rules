rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function partyData(partyId) {
      return get(/databases/$(database)/documents/parties/$(partyId)).data;
    }

    function isPartyMember(partyId) {
      return isSignedIn() && request.auth.uid in partyData(partyId).members;
    }

    function isPartyGM(partyId) {
      return isSignedIn() && request.auth.uid == partyData(partyId).gm;
    }

    // Keep this list in sync with the keys of LIBRARY_KINDS in
    // src/data/libraryKinds.js — it's the allow-list for the generic
    // lore-library wildcard match below.
    function isLoreKind(kind) {
      return kind in ['npcs', 'places', 'history', 'religions', 'factions', 'quests'];
    }

    function sessionPartyId(sessionId) {
      return get(/databases/$(database)/documents/scheduledSessions/$(sessionId)).data.partyId;
    }

    // ---------- Combat Tracker: per-user private subcollections ----------
    // (characters, customMonsters, etc). This project's Firebase Auth +
    // Firestore database is shared between the Session Journal and the
    // Combat Tracker app, so their rules live together in this one file —
    // only one ruleset can be active for the database at a time.
    // Narrowed from Combat Tracker's original `users/{userId}/{document=**}`
    // (which also covered the bare users/{uid} root doc) to require at
    // least one named subcollection segment, so it no longer overlaps with
    // the shared users/{uid} profile rules below. Combat Tracker's code
    // only ever writes to users/{uid}/characters/... and
    // users/{uid}/customMonsters/..., so this is a no-op for it.
    match /users/{userId}/{subcollection}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ---------- users (shared profile doc, Session Journal) ----------
    match /users/{uid} {
      // Any signed-in user can read basic profile docs — needed for the
      // "shared with" picker and party-member lists (no server-side join).
      allow read: if isSignedIn();

      allow create: if isSelf(uid)
        && request.resource.data.role in ['player', 'gm']
        && request.resource.data.partyId == null;

      // Self-updates only; role and email are immutable after creation.
      // partyId is intentionally left unconstrained here — it's set by
      // the create/join-party flow.
      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.username is string
        && request.resource.data.email == resource.data.email;

      // Self-delete only — used by account deletion (mobile app Settings).
      allow delete: if isSelf(uid);
    }

    // ---------- parties ----------
    match /parties/{partyId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && userData(request.auth.uid).role == 'gm'
        && request.resource.data.gm == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      // Own uid only, either direction: a no-op, the caller's own uid
      // appended (joining), or the caller's own uid removed (leaving, or
      // account deletion cleaning up membership). name/inviteCode/gm are
      // immutable after creation.
      allow update: if isSignedIn()
        && request.resource.data.name == resource.data.name
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.gm == resource.data.gm
        && (
          request.resource.data.members == resource.data.members
          || request.resource.data.members ==
             resource.data.members.concat([request.auth.uid])
          || request.resource.data.members ==
             resource.data.members.removeAll([request.auth.uid])
        );

      allow delete: if false;

      // ---------- party bank (shared per-party inventory) ----------
      match /inventory/{itemId} {
        allow read, create, update, delete: if isPartyMember(partyId);
      }

      // ---------- player character summaries (self-owned, not GM-owned) ----------
      // Doc ID is the owning player's own uid — the inverse permission model
      // from the lore libraries below: only the character's own player can
      // write it, never the GM. The `{kind}` wildcard lore block further down
      // structurally matches this path too, but isLoreKind('characters') is
      // false, so it contributes zero permission here (same reasoning as the
      // inventory comment above) — this block is the sole grant of access.
      match /characters/{uid} {
        allow read: if isPartyMember(partyId);

        allow create, update: if isSelf(uid)
          && isPartyMember(partyId)
          && request.resource.data.name is string
          && request.resource.data.description is string;

        allow delete: if isSelf(uid);
      }

      // ---------- GM lore libraries (NPCs, Places, History, Religions, Factions/Orgs) ----------
      // GM-authored, GM-only by default; each entry has its own `shared`
      // flag the GM flips to reveal it to the whole party. Read access
      // depends on `resource.data.shared`, so any client query for a
      // non-GM viewer MUST include where('shared','==',true) or Firestore
      // rejects the whole query (rules can't filter list results, only
      // accept/reject the query as a whole).
      // `{kind}` is a wildcard collection-name match guarded by
      // isLoreKind(), so it never grants anything for `inventory` above —
      // isLoreKind('inventory') is false, so every allow condition here
      // short-circuits to false for that collection and the dedicated
      // inventory rule above remains the only thing granting access to it.
      match /{kind}/{entryId} {
        allow read: if isLoreKind(kind)
          && (isPartyGM(partyId) || (isPartyMember(partyId) && resource.data.shared == true));

        allow create: if isLoreKind(kind)
          && isPartyGM(partyId)
          && request.resource.data.name is string
          && request.resource.data.lore is string
          && request.resource.data.shared is bool
          && (!('status' in request.resource.data) || request.resource.data.status in ['open', 'resolved'])
          && request.resource.data.createdBy == request.auth.uid;

        allow update: if isLoreKind(kind)
          && isPartyGM(partyId)
          && request.resource.data.name is string
          && request.resource.data.lore is string
          && request.resource.data.shared is bool
          && (!('status' in request.resource.data) || request.resource.data.status in ['open', 'resolved'])
          && request.resource.data.createdBy == resource.data.createdBy;

        allow delete: if isLoreKind(kind) && isPartyGM(partyId);
      }
    }

    // ---------- session notes ----------
    match /sessionNotes/{noteId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.visibleTo;

      allow create: if isSignedIn()
        && request.resource.data.author == request.auth.uid
        && request.auth.uid in request.resource.data.visibleTo;

      allow update, delete: if isSignedIn() && resource.data.author == request.auth.uid;
    }

    // ---------- scheduled sessions (GM-set, party RSVPs) ----------
    match /scheduledSessions/{sessionId} {
      allow read: if isPartyMember(resource.data.partyId);

      allow create: if isPartyGM(request.resource.data.partyId)
        && request.resource.data.dateTime is timestamp
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isPartyGM(resource.data.partyId)
        && request.resource.data.partyId == resource.data.partyId
        && request.resource.data.dateTime is timestamp
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if isPartyGM(resource.data.partyId);

      match /rsvps/{uid} {
        allow read: if isPartyMember(sessionPartyId(sessionId));

        allow create, update: if isSignedIn() && request.auth.uid == uid
          && isPartyMember(sessionPartyId(sessionId))
          && request.resource.data.status in ['yes', 'maybe', 'no'];

        allow delete: if isSignedIn() && request.auth.uid == uid;
      }
    }
  }
}
